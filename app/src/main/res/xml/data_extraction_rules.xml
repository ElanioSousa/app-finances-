<?xml version="1.0" encoding="utf-8"?>
<!--
    Os dados financeiros não vão para o backup na nuvem do Google: o app promete que nada sai
    do celular. O usuário faz o próprio backup (manual ou automático, numa pasta que escolhe).
    Na troca de celular (cabo, Smart Switch), tudo passa de um aparelho para o outro.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
